{
  "$defs": {
    "DiagnosticSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "DiagnosticSeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "severity": {
      "$ref": "#/$defs/DiagnosticSeverity"
    },
    "code": {
      "title": "Code",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "project_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Key"
    },
    "file_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Path"
    },
    "start_line": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start Line"
    }
  },
  "required": [
    "severity",
    "code",
    "message"
  ],
  "title": "Diagnostic",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codegraphify/contract/diagnostic.schema.json"
}
